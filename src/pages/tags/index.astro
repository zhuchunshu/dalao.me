---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { visiblePosts, collectTags } from '../../lib/utils';

const posts = visiblePosts(await getCollection('blog'));
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <header class="page-header">
    <div class="container container--wide">
      <h1 class="page-header__title">标签</h1>
      <p class="page-header__desc">共 {tags.length} 个标签。</p>
    </div>
  </header>

  <div class="container container--wide">
    {
      tags.length === 0 ? (
        <p class="empty">还没有标签。给文章 frontmatter 里的 tags 加几项就会出现。</p>
      ) : (
        <div class="tag-cloud">
          {tags.map(({ tag, count }) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="tag tag--lg">
              {tag}
              <span class="tag__count">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

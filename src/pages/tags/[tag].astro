---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { visiblePosts, sortByDateDesc, formatDate, collectTags } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  const tags = collectTags(posts);

  return tags.map(({ tag, count }) => ({
    params: { tag },
    props: {
      tag,
      count,
      posts: sortByDateDesc(posts.filter((p) => p.data.tags.includes(tag))),
    },
  }));
}

const { tag, count, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`带有「${tag}」标签的文章，共 ${count} 篇。`}>
  <header class="page-header">
    <div class="container container--wide">
      <p class="detail-eyebrow"><a href="/tags/">标签</a></p>
      <h1 class="page-header__title">{tag}</h1>
      <p class="page-header__desc">共 {posts.length} 篇</p>
    </div>
  </header>

  <div class="container container--wide">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}/`} class="post-item__link">
              <span>
                <span class="post-item__title">{post.data.title}</span>
                <span class="post-item__desc">{post.data.description}</span>
              </span>
              <time class="post-item__date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="list-footnote"><a href="/tags/">← 全部标签</a></p>
  </div>
</BaseLayout>

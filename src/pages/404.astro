---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面不存在" description="404 —— 这个地址上没有内容。" noindex>
  <section class="container container--narrow notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">这个地址上没有东西</h1>
    <p class="notfound__desc">
      链接可能已经失效，或者从来没存在过。也可能是我改过文章的网址。
    </p>

    <div class="hero__actions">
      <a href="/" class="btn btn--primary">
        <Icon name="arrow-left" size="0.95em" />
        回到首页
      </a>
      <a href="/blog/" class="btn">读文章</a>
    </div>
  </section>
</BaseLayout>

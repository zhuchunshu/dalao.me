// 未知图标名回退到 link，避免整页因拼写错误而崩
const markup = ICONS[name] ?? ICONS.link!;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className || undefined}
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>

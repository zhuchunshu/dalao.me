---
/**
 * 内联 SVG 图标集（零网络请求、无图标字体）。
 * 品牌图标保持实心以维持品牌识别；功能图标统一线性风格，笔画粗细一致。
 * 想加新图标：在 ICONS 里加一条即可，name 与 src/data/site.json 里 socials 的 icon 字段对应。
 */
interface Props {
  name: string;
  /** 尺寸，默认 1em（跟随字号） */
  size?: string;
  class?: string;
}

